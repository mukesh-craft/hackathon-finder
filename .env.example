# Copy to .env and adjust. Never commit a real .env with secrets.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Leave empty to use the embedded PostgreSQL (PGlite, same engine & SQL).
# Set to a connection string to use a real PostgreSQL server in production.
# Example: postgres://hackfinder:SECRET@db:5432/hackfinder
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=./frontend/dist

# Required to enable POST /api/admin/crawl and POST /api/admin/ingest-url.
# READ /api/admin/stats and /api/admin/crawls need the token as well when set.
ADMIN_TOKEN=

# API rate limit: requests per window per IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Outbound politeness (applies to every source adapter).
HTTP_USER_AGENT=HackathonFinderBot/1.0 (+https://github.com/hackathon-finder)
HTTP_TIMEOUT_MS=20000
HTTP_MAX_BYTES=8388608
HTTP_MAX_REDIRECTS=3
HTTP_PER_HOST_DELAY_MS=1200
HTTP_RETRIES=3

# Geocoding (Photon, OpenStreetMap-based). Disabled automatically in tests.
GEOCODER_ENABLED=true
GEOCODER_ENDPOINT=https://photon.komoot.io/api/
GEOCODER_MIN_INTERVAL_MS=1100
GEOCODER_TIMEOUT_MS=12000

# Source toggles. HackerEarth stays off: its listings are client-rendered and
# its robots.txt disallows the AJAX endpoints that would serve the data.
ADAPTER_UNSTOP_ENABLED=true
ADAPTER_DEVPOST_ENABLED=true
ADAPTER_MLH_ENABLED=true
ADAPTER_HACKEREARTH_ENABLED=false
ADAPTER_ORGANIZER_ENABLED=true

# Devpost publishes one submission deadline; registration closes with it.
# true  -> mirror it into registration_deadline, labelled "inferred".
# false -> leave registration_deadline null ("Not specified").
DEVPOST_INFER_REGISTRATION_DEADLINE=true
DEVPOST_DETAIL_ENRICHMENT=true
DEVPOST_MAX_DETAIL_FETCHES=400

# Ingestion paging.
INGEST_MAX_PAGES=12
INGEST_PAGE_SIZE=25
UNSTOP_OPPSTATUS=open

# Background refresh inside the API process (use workers/refresh-worker.ts
# as a separate process in production).
REFRESH_ENABLED=true
REFRESH_INTERVAL_MS=900000
REFRESH_BATCH_SIZE=25

# Refresh-on-visit: each search may start one background crawl of the fast
# sources (Unstop + MLH), at most once per interval. Responses never wait.
VISIT_REFRESH_ENABLED=true
VISIT_REFRESH_INTERVAL_MS=1800000
MANUAL_REFRESH_INTERVAL_MS=300000

# Seed an empty database automatically on server boot (fresh deploys).
INGEST_ON_BOOT=false
